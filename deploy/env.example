# Copy to .env or set before running deploy.sh
# deploy.sh generates .env automatically - these are for reference

LIVEKIT_PUBLIC_IP=1.2.3.4
TURN_DOMAIN=turn.example.com
LIVEKIT_REGION=us-east-1

# Optional - deploy.sh generates if not set
# REDIS_PASSWORD=
# TURN_CREDENTIAL=
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=

# Webhook URL for Convex (room/participant events). Set in Coolify on LiveKit Stack app.
# LIVEKIT_WEBHOOK_URL=https://patient-crocodile-0.eu-west-1.convex.site/livekit-webhook
