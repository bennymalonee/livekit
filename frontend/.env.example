########################################
# LivKit Dashboard environment (example)
########################################

#
# Convex (frontend URL)
#
# Development Convex deployment (from Convex dashboard after linking)
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud

# For production (set in Coolify for the dashboard app, not here):
# NEXT_PUBLIC_CONVEX_URL=https://your-production-deployment.convex.cloud

#
# Deploy page / LiveKit integration (optional but recommended)
#
# Coolify deploy webhook used by the Deploy page and convex/settings.ts
# COOLIFY_DEPLOY_WEBHOOK_URL=https://coolify.your-domain.com/api/webhook/...

# Public LiveKit URL used by the UI (e.g. Deploy + Dashboard)
# NEXT_PUBLIC_LIVEKIT_URL=https://livekit.your-domain.com

# Coolify app UUIDs (for Deploy prefill, Diagnostics/Vault/Terminal Coolify logs and env)
# Get from Coolify → your app → Settings or URL
# NEXT_PUBLIC_COOLIFY_DASHBOARD_APP_UUID=your-dashboard-app-uuid
# NEXT_PUBLIC_COOLIFY_LIVEKIT_STACK_APP_UUID=your-livekit-stack-app-uuid

#
# Convex Auth (set on the Convex deployment, not in this file)
#
# Use `npm run convex:auth:env` from frontend/ to generate and set:
#   JWT_PRIVATE_KEY
#   JWKS
# in the currently targeted Convex deployment.
#
# CONVEX_SITE_URL is built-in on Convex and set automatically.

